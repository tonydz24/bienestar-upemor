APP_NAME="Bienestar UPEMOR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================================
# CONFIGURACIÓN DE BASE DE DATOS LOCAL (XAMPP / MARIADB / MYSQL)
# =========================================================================
# Configure los parámetros de acuerdo a su entorno local en XAMPP.
# El puerto predeterminado de MySQL en XAMPP suele ser 3306 (o 3308 si está personalizado).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bienestar_upemor
DB_USERNAME=root
DB_PASSWORD=

# =========================================================================
# SESIONES, CACHÉ Y COLAS
# =========================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# =========================================================================
# SERVICIO DE CORREO (ENTORNO LOCAL DE PRUEBAS)
# =========================================================================
# Por defecto en desarrollo los correos se registran en storage/logs/laravel.log
# Si utiliza Mailpit / MailHog, configure MAIL_MAILER=smtp con host 127.0.0.1 y puerto 1025.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bienestar@upemor.edu.mx"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
# CONTRASEÑAS INICIALES PARA SEEDERS DE DEMOSTRACIÓN (NO USAR EN PRODUCCIÓN)
# =========================================================================
# Se utilizan exclusivamente si se ejecutan seeders en ambiente local.
INITIAL_ADMIN_PASSWORD=
INITIAL_DOCENTE_PASSWORD=
TEST_USER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
